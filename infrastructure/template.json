{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Grace Vision private demo, Frankfurt. No public endpoint or publishing API.",
  "Parameters": {
    "ImageUri": {
      "Type": "String",
      "AllowedPattern": "[0-9]{12}\\.dkr\\.ecr\\.eu-central-1\\.amazonaws\\.com/[a-z0-9._/-]+@sha256:[0-9a-f]{64}",
      "Description": "Verified immutable Linux amd64 image digest in Frankfurt ECR"
    }
  },
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "originals-demo-expiry",
              "Status": "Enabled",
              "Prefix": "originals/",
              "ExpirationInDays": 7,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "derivatives-demo-expiry",
              "Status": "Enabled",
              "Prefix": "derivatives/",
              "ExpirationInDays": 7,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "traces-demo-expiry",
              "Status": "Enabled",
              "Prefix": "traces/",
              "ExpirationInDays": 7,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "approvals-demo-expiry",
              "Status": "Enabled",
              "Prefix": "approvals/",
              "ExpirationInDays": 7,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "GraceVision"
          },
          {
            "Key": "Competition",
            "Value": "OpenCV-AI-Competition-2026"
          },
          {
            "Key": "Environment",
            "Value": "competition-demo"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DataBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DataBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DataBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${DataBucket.Arn}/*"
              },
              "Condition": {
                "Null": {
                  "s3:if-none-match": "true"
                }
              }
            }
          ]
        }
      }
    },
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-analysis"
        },
        "RetentionInDays": 7,
        "Tags": [
          {
            "Key": "Project",
            "Value": "GraceVision"
          },
          {
            "Key": "Competition",
            "Value": "OpenCV-AI-Competition-2026"
          },
          {
            "Key": "Environment",
            "Value": "competition-demo"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PrivateJobStorageOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${DataBucket.Arn}/originals/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/derivatives/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/traces/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/approvals/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "DataBucket",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "originals/*",
                        "derivatives/*",
                        "traces/*",
                        "approvals/*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "LogGroup",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "GraceVision"
          },
          {
            "Key": "Competition",
            "Value": "OpenCV-AI-Competition-2026"
          },
          {
            "Key": "Environment",
            "Value": "competition-demo"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "AnalysisFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-analysis"
        },
        "PackageType": "Image",
        "Code": {
          "ImageUri": {
            "Ref": "ImageUri"
          }
        },
        "Architectures": [
          "x86_64"
        ],
        "Role": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "MemorySize": 2048,
        "Timeout": 180,
        "ReservedConcurrentExecutions": 2,
        "EphemeralStorage": {
          "Size": 1024
        },
        "Environment": {
          "Variables": {
            "DATA_BUCKET": {
              "Ref": "DataBucket"
            },
            "GRACEVISION_STORAGE": "s3"
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "LogGroup"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "GraceVision"
          },
          {
            "Key": "Competition",
            "Value": "OpenCV-AI-Competition-2026"
          },
          {
            "Key": "Environment",
            "Value": "competition-demo"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "AsyncLimits": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "AnalysisFunction"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 0,
        "MaximumEventAgeInSeconds": 60
      }
    }
  },
  "Outputs": {
    "FunctionName": {
      "Value": {
        "Ref": "AnalysisFunction"
      }
    },
    "FunctionArn": {
      "Value": {
        "Fn::GetAtt": [
          "AnalysisFunction",
          "Arn"
        ]
      }
    },
    "DataBucket": {
      "Value": {
        "Ref": "DataBucket"
      }
    }
  }
}
